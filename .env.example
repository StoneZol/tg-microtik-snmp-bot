# Language for Telegram messages (locale file in /app/locales)
# Prefer BOT_LANG — plain LANG is also read for compatibility, but Docker/OS may set LANG=C.UTF-8
BOT_LANG=en

# Path to device configs directory (inside container)
CONFIG_DIR=/app/config/devices

# Persistent state directory (mount a volume here)
# Holds per-device JSON + subscribers.sqlite (who /start'd each bot)
STATE_DIR=/data/state

# --- Secrets referenced from device YAML via *_env keys ---

# SNMP communities
SNMP_COMMUNITY_OFFICE=public

# Telegram bot tokens (chat ids are no longer required in env —
# recipients come from whitelist + users who pressed /start)
BOT_MAIN_TOKEN=123456:REPLACE_ME
BOT_OWNER_OFFICE_TOKEN=123456:REPLACE_ME
